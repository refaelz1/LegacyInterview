# Legacy Code Simulator - Environment Variables
# Add your OpenAI API key below

OPENAI_API_KEY=your_api_key_here
AGENT_MODEL=gpt-4o

# Intel proxy settings (uncomment when on Intel network)
# http_proxy=http://proxy-iil.intel.com:912
# https_proxy=http://proxy-iil.intel.com:912
# no_proxy=localhost,127.0.0.1

# Optional: Google Sheets Integration
# Get Sheet ID from URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
# GOOGLE_SHEET_ID=your_google_sheet_id_here

# Optional: Google Drive Backup
# Get Folder ID from URL: https://drive.google.com/drive/folders/{FOLDER_ID}
# GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here
